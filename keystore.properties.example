# Copy to keystore.properties (gitignored) and fill in to sign release builds.
# Generate a keystore with:
#   keytool -genkeypair -v -keystore release.keystore -alias lightmeter \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=release.keystore
storePassword=
keyAlias=lightmeter
keyPassword=
